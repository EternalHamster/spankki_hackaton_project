# Copy values into your process environment; this file is not auto-loaded.
# anthropic (direct credits), vertex (Google managed), google_cloud (Anthropic managed)
CLAUDE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=global
# Required only for google_cloud; both cloud providers authenticate with Google ADC.
ANTHROPIC_GOOGLE_CLOUD_WORKSPACE_ID=
CLAUDE_MODEL=claude-haiku-5-5
DUCKDB_PATH=data/finance.duckdb
# The coach's "today" (YYYY-MM-DD). Empty = last transaction date in the snapshot (2026-09-30 for the
# hackathon data), so "last month" means August 2026 rather than a month with no data.
COACH_AS_OF=
# Explicit opt-in for local/synthetic demos only. No client customer_id is accepted.
DEMO_MODE=false
DEMO_TOKENS_JSON={}
CORS_ORIGINS=http://127.0.0.1:4173
REQUESTS_PER_MINUTE=10
PROCESS_CHAT_LIMIT=500
