# Local Node run: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
# Server only; never put this key in public/ or commit a populated .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Initial selection only; the public demo selector allows three synthetic customers.
PUBLIC_DEMO_CUSTOMER_ID=CUST00207
# Required in production/Compose: random, stable value of at least 32 characters.
# Cloud Run uses Secret Manager oma-talous-demo-session:1. Never commit this value.
# Optional for local development; an omitted value gives a process-local secret.
DEMO_SESSION_SECRET=

# Python 3.12+ with runtime/requirements.txt (DuckDB 2.0.0).
# The server automatically prefers ui-demos/.venv; leave overrides unset normally.
# COACH_PYTHON=C:/path/to/ui-demos/.venv/Scripts/python.exe
# COACH_CODE_ROOT=C:/path/to/spankki_hackaton_project
# COACH_DB_PATH=C:/path/to/spankki_hackaton_project/BDA/output/coach.duckdb
# COACH_SNAPSHOT_VERSION=optional-immutable-snapshot-version

# Used by Docker Compose for the host-side port only.
# The container always listens on 0.0.0.0:8080.
LOCAL_PORT=8080
