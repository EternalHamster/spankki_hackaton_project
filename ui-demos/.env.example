# Local Node run: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
# Server only; never put this key in public/ or commit a populated .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Used by Docker Compose for the host-side port only.
# The container always listens on 0.0.0.0:8080.
LOCAL_PORT=8080
